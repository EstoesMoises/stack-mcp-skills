{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "smoke_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "passed", "evidence_ref"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 4},
        "passed": {"const": true},
        "evidence_ref": {"type": "string", "pattern": "^evidence/[a-z0-9][a-z0-9._/-]*$", "maxLength": 512}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "client_version", "catalog_commit", "skill_id", "skill_version", "tenant_purpose", "smoke_tests", "reviewer", "review_date"],
      "properties": {
        "adapter": {"enum": ["codex", "claude-code", "cursor", "github-copilot"]},
        "client_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "catalog_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "skill_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "tenant_purpose": {"const": "non-production skill validation"},
        "smoke_tests": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/smoke_test"}},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 200},
        "review_date": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"}
      }
    }
  }
}
