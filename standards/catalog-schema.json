{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "skills"],
  "properties": {
    "catalog_version": {"const": "1.0.0"},
    "skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "tool": {
      "type": "string",
      "enum": [
        "search",
        "get_question",
        "get_article",
        "get_comments",
        "get_questions_to_answer",
        "get_existing_tags",
        "recommend_SME",
        "create_article",
        "create_question",
        "create_QA",
        "draft_question",
        "submit_user_answer",
        "update_answer",
        "update_question",
        "vote"
      ]
    },
    "write_action": {
      "type": "string",
      "enum": [
        "draft_question",
        "create_question",
        "create_QA",
        "create_article",
        "submit_user_answer",
        "update_question",
        "update_answer",
        "vote"
      ]
    },
    "adapter_state": {
      "type": "string",
      "enum": ["supported", "experimental", "unsupported"]
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude-code", "cursor", "github-copilot"],
      "properties": {
        "codex": {"$ref": "#/$defs/adapter_state"},
        "claude-code": {"$ref": "#/$defs/adapter_state"},
        "cursor": {"$ref": "#/$defs/adapter_state"},
        "github-copilot": {"$ref": "#/$defs/adapter_state"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "tier",
        "summary",
        "path",
        "tags",
        "required_tools",
        "write_actions",
        "adapters"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "tier": {"enum": ["core", "extended"]},
        "summary": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^skills/(core|extended)/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_tools": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
        "write_actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/write_action"}},
        "adapters": {"$ref": "#/$defs/adapters"}
      }
    }
  }
}
